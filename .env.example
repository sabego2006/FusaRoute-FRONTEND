# Variables de entorno del frontend de FusaRoute.
#
# Este archivo ES la documentacion: si una variable no esta aqui, no existe.
# Copiar a .env y llenarlo con los valores propios. El .env NUNCA se versiona.
#
#   cp .env.example .env
#
# ADVERTENCIA (seccion 12 de la guia de buenas practicas): todo lo que se
# compila en Angular viaja al navegador y es inspeccionable. Aqui NO va ninguna
# credencial secreta. Los secretos viven solo en el backend.

# Quien lee estas variables: el CONTENEDOR Docker del frontend, al arrancar
# (Nginx las publica en /config.json y Angular las lee antes de iniciar; ver la
# seccion "Docker" del README). `ng serve` y el build de Vercel NO las leen:
# ahi los valores salen de src/environments/.

# URL base de la API del backend, vista desde el navegador.
# En DEV: http://localhost:8080
API_URL=http://localhost:8080

# Clave de Google Maps del FRONTEND. Es publica por naturaleza y distinta de la
# del backend; lo que la protege es la restriccion por dominio en Google Cloud.
GOOGLE_MAPS_API_KEY=
