# Workaround: @angular/service-worker 21.2.24 requiere @angular/core 21.2.24,
# pero npm resuelve @angular/core a 21.2.22 (la version mas reciente que comparten
# los demas paquetes @angular/*). Esto provoca un conflicto de peer-dependency que
# impide ejecutar `npm ci` limpio. legacy-peer-deps evita que npm rechace la
# instalacion por esa diferencia de parche.
# Se revisa al proximo bump de Angular (cuando todas las versiones vuelvan a estar
# sincronizadas en una misma release).
legacy-peer-deps=true
